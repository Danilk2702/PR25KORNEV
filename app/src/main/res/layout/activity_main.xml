<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <Button
            android:id="@+id/btnShowBasic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Показать простое уведомление" />


        <Button
            android:id="@+id/btnShowBigText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Уведомление" />


        <Button
            android:id="@+id/btnShowBigPicture"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Уведомление" />


        <Button
            android:id="@+id/btnShowInbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Уведомление" />

        <!-- Задание 4: Уведомление-мессенджер -->
        <Button
            android:id="@+id/btnShowMessaging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Уведомление" />

        <!-- Кнопки для управления службой уведомлений -->
        <Button
            android:id="@+id/btnListNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Список уведомлений (служба)" />

        <Button
            android:id="@+id/btnClearNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Очистить все уведомления" />

        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Лог уведомлений:"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>